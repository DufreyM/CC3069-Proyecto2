flowchart TD
    A([Inicio]) --> B["salto = p*K; inicio = r*K; actual = inicio;<br/>resto = min(K, N-inicio)"]
    B --> C{resto == 0?}
    C -- si --> D["inicio += salto"]
    D --> E{inicio >= N?}
    E -- si --> F([Agotado])
    E -- no --> G["actual = inicio;<br/>resto = min(K, N-inicio)"]
    G --> H
    C -- no --> H["entregar actual"]
    H --> I["actual++; resto--"]
    I --> C
